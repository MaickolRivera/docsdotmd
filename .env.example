# Copia este archivo como .env.local y completa los valores. Nunca subas .env.local al repositorio.

# Supabase → Project Settings → API.
# La URL y la llave anon (o publishable) son públicas por diseño: la seguridad está en RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública del sitio, usada en los enlaces de los correos (ej. https://docsdotmd.vercel.app).
# En local: http://localhost:3000. En Vercel es opcional: sin ella, producción usa el
# dominio del proyecto y las vistas previas su propia URL.
NEXT_PUBLIC_SITE_URL=

# Opcional: enviar las invitaciones por correo con Resend.
# Si no se configura, el enlace de invitación se muestra para copiarlo y compartirlo.
RESEND_API_KEY=
EMAIL_FROM=

# Solo para las pruebas e2e (crear usuarios de prueba). Nunca en Vercel ni con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
