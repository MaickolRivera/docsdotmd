# Copia este archivo como .env.local y completa los valores. Nunca subas .env.local al repositorio.

# Supabase → Project Settings → API.
# La URL y la llave anon (o publishable) son públicas por diseño: la seguridad está en RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública del sitio, usada en los enlaces de los correos (ej. https://docsmd.vercel.app).
# En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=
